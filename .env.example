# ================== CẤU HÌNH CHUNG ==================
PORT=3000
NODE_ENV=development
# Chuỗi bí mật ký session – ĐỔI khi chạy thật (chuỗi ngẫu nhiên dài)
SESSION_SECRET=doi-chuoi-bi-mat-nay-khi-chay-that

# ================== MYSQL ==================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=qlbg
DB_PASSWORD=qlbg_dev_2026
DB_NAME=qlbg
DB_POOL_SIZE=10

# ================== LƯU TRỮ BÀI GIẢNG ==================
# local  = lưu file trong thư mục ./storage (dùng cho demo)
# gdrive = lưu file trên Google Drive
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage

# ---- Google Drive (chỉ cần khi STORAGE_DRIVER=gdrive) ----
# ID thư mục gốc trên Drive (lấy từ URL: drive.google.com/drive/folders/<ID>)
GDRIVE_ROOT_FOLDER_ID=

# Cách 1 (khuyên dùng với Gmail cá nhân): OAuth2 – chạy `npm run gdrive:auth` để lấy refresh token
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=

# Cách 2 (Google Workspace + Shared Drive): Service Account – đường dẫn file JSON key
GDRIVE_SERVICE_ACCOUNT_KEY=
