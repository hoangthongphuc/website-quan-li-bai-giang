<%- include('partials/header') %>
<section class="page-head">
  <div>
    <h1>Chọn bài giảng</h1>
    <p class="muted">Xin chào <strong><%= currentUser.full_name %></strong> — chọn một học phần để xem giới thiệu và danh sách bài giảng.</p>
  </div>
  <form class="search" method="get" action="/">
    <input name="q" value="<%= q %>" placeholder="Tìm theo mã, tên học phần…">
    <button class="btn">Tìm</button>
  </form>
</section>

<% if (!courses.length) { %>
  <div class="empty-state"><div class="big">🗂️</div><h3>Chưa có học phần nào</h3>
    <p><%= q ? 'Không tìm thấy học phần phù hợp.' : 'Bạn chưa được cấp quyền truy cập học phần nào.' %></p></div>
<% } else { %>
<div class="course-grid">
  <% courses.forEach(c => { %>
  <a class="course-card" href="/courses/<%= c.id %>">
    <div class="course-cover" style="background: linear-gradient(135deg, <%= c.color %>, <%= c.color %>bb)">
      <span class="course-code"><%= c.code || 'HP' %></span>
      <% if (c.visibility === 'restricted') { %><span class="pill pill-light">🔒 Giới hạn</span><% } %>
      <% if (!c.is_published) { %><span class="pill pill-warn">Bản nháp</span><% } %>
    </div>
    <div class="course-body">
      <h3><%= c.title %></h3>
      <p><%= c.summary || 'Chưa có mô tả.' %></p>
      <div class="course-meta"><span>👤 <%= c.owner_name || '—' %></span><span>📄 <%= c.lecture_count %> bài</span></div>
    </div>
  </a>
  <% }) %>
</div>
<% } %>
<%- include('partials/footer') %>
